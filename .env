# ECR Configuration
# IMPORTANT: These values are overridden by GitHub Actions secrets during deployment
# For local development, set ACCOUNT_ID and AWS_REGION as environment variables
ACCOUNT_ID=${ACCOUNT_ID:-703544859494}
AWS_REGION=${AWS_REGION:-us-east-1}
# ECS Configuration
ECS_SUBNET_GROUP_NAME=Public
ECS_CONTAINER_PORT=4000
ECS_DESIRED_COUNT=0
ECS_CPU=256
ECS_MEMORY_MIB=512

# Network Configuration (Minimal MVP - single AZ, public subnets only, no NAT)
MAX_AZS=2
NAT_GATEWAYS=0
ENABLE_PUBLIC_SUBNETS=true
ENABLE_PRIVATE_EGRESS_SUBNETS=false
ENABLE_ISOLATED_SUBNETS=true
ENABLE_FLOW_LOGS=false

# Optional Features
ENABLE_INTERFACE_ENDPOINTS=false
